# Downloaded source data - regenerable from MANIFEST.json, too large for git.
# MANIFEST.json itself IS tracked: it is the provenance record (Principle 3).
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.json

data/interim/*
!data/interim/.gitkeep

# Processed outputs are tracked once stable - see CONTEXT.md before committing large files.
data/processed/*
!data/processed/.gitkeep

output/*
!output/.gitkeep

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store

# questionnaire sessions are personal working state, not project history
profiles/.sessions/

# Completed profiles are held out of git PENDING EMIL'S EXPLICIT DECISION, not by policy.
# They carry his real housing budget and his political and religious opt-ins — the most
# personal things this project holds — and this repo is on GitHub. He has never been asked
# whether he wants them versioned, so the safe default holds until he says otherwise.
#
# This was briefly got wrong: emil.yaml was committed in a rewritten commit (unpushed, so
# nothing left this machine) because these lines were lost with a container and the
# exclusion existed only as something a session remembered. It is written down now.
# Remove these two lines the moment he says to commit them; nothing else depends on it.
profiles/emil.yaml
profiles/winsor.yaml

# web app: dependencies, build output, and the data bundle copied in from output/atlas
web/node_modules/
web/dist/
web/public/data/
web/public/geo/

web/dist-preview/
